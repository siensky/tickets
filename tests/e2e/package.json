    "@tickets/redis": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@zxing/library": "0.23.0",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
