# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local
!.env.example

# Terraform — state contains secrets in plaintext, never commit
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
# .terraform.lock.hcl is NOT gitignored — it has no secrets, only provider
# checksums, and should be committed for reproducible provider versions.

# Fetched kubeconfig — contains the cluster's client certificate/key.
infra/terraform/**/.kube/
infra/terraform/**/.kube-config-raw

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Test / coverage
coverage/
.nyc_output/

# Expo
apps/scanner/.expo/

# Vite
apps/web/dist/

# Misc
*.local
