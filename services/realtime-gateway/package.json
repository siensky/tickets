{
  "name": "@tickets/realtime-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@tickets/auth": "workspace:*",
    "@tickets/domain": "workspace:*",
    "@tickets/observability": "workspace:*",
    "@tickets/redis": "workspace:*",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/ws": "8.18.2"
  }
}
