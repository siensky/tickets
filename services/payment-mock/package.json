{
  "name": "@tickets/payment-mock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@tickets/domain": "workspace:*",
    "@tickets/observability": "workspace:*",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
