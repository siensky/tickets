{
  "name": "@tickets/scheduler-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration --no-file-parallelism",
    "reset-sale": "tsx src/scripts/reset-sale.ts",
    "generate-sale-report": "tsx src/scripts/generate-sale-report.ts",
    "seed-demo-events": "tsx src/scripts/seed-demo-events.ts",
    "import-tickets": "tsx src/scripts/import-tickets.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@tickets/db": "workspace:*",
    "@tickets/domain": "workspace:*",
    "@tickets/observability": "workspace:*",
    "@tickets/rabbit": "workspace:*",
    "@tickets/redis": "workspace:*",
    "amqplib": "2.2.0",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/amqplib": "0.10.8",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "testcontainers": "12.2.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
