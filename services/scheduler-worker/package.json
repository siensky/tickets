    "@tickets/rabbit": "workspace:*",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.1",
    "@types/amqplib": "0.10.8",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "amqplib": "2.2.0",
    "pg": "8.23.1",
    "testcontainers": "12.2.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
