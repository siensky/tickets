      "Read(//Users/siennalansky/Downloads/tickets/infra/terraform/**/.kube-config-raw)",
      "Read(//Users/siennalansky/.tikknet-tf.env)",
      "Read(//Users/siennalansky/.ssh/**)",
      "Read(//Users/siennalansky/.aws/**)",
      "Read(//Users/siennalansky/.kube/**)",
