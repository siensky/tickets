        "/Users/siennalansky/.tikknet-tf.env",
        "/Users/siennalansky/.ssh",
        "/Users/siennalansky/.aws",
        "/Users/siennalansky/.kube",
        "/Users/siennalansky/.config/gh",
        "/Users/siennalansky/.netrc",
        "/Users/siennalansky/Downloads/tickets/infra/terraform/.kube/config",
        "/Users/siennalansky/Downloads/tickets/infra/terraform/.kube-config-raw",
        "/Users/siennalansky/Downloads/tickets/infra/terraform/.terraform/terraform.tfstate",
