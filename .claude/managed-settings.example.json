      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(pg_restore *)",
      "Bash(redis-cli *)",
      "Bash(scripts/loadtest-mode.sh *)",
      "Bash(./scripts/loadtest-mode.sh *)",
      "Read(//Users/siennalansky/Downloads/tickets/**/.env)",
      "Read(//Users/siennalansky/Downloads/tickets/**/.env.local)",
      "Read(//Users/siennalansky/Downloads/tickets/**/.env.*.local)",
