{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git tag *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl set *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout undo *)",
      "Bash(scripts/loadtest-mode.sh *)",
      "Bash(./scripts/loadtest-mode.sh *)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/infra/terraform/**/*.tfstate*)",
      "Read(/infra/terraform/**/.kube/**)",
      "Read(/infra/terraform/**/.kube-config-raw)",
      "Read(~/.tikknet-tf.env)",
      "Edit(/.claude/state/**)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git config *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(gh *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(psql *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker system *)",
      "Bash(docker volume *)"
    ],
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm test:contract)",
      "Bash(pnpm format:check)",
      "Bash(node .claude/hooks/verify.mjs)",
      "Bash(node .claude/hooks/verify.mjs --scope full)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Kontrollerar kommandot"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/require-verify.mjs"],
            "timeout": 30,
            "statusMessage": "Kontrollerar verifieringsposten"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/require-verify.mjs"],
            "timeout": 30,
            "statusMessage": "Kontrollerar verifieringsposten"
          }
        ]
      }
    ]
  }
}
