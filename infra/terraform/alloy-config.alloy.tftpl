// Alloy config (docs/plan.md "Observability"). Two independent pipelines:
// 1. Kubernetes pod logs -> Loki.
// 2. OTLP traces from shared/observability/src/tracing.ts -> the debug exporter (all spans, kept until Tempo is
//    proven) and, when var.tempo_enabled, a probabilistic sampler -> Tempo (docs/plan.md 8.7).
//    This is a Terraform template (templatefile in observability.tf): its if-blocks are Terraform template directives.
//    Validate by rendering it first, e.g. `terraform console` ->
//    templatefile("alloy-config.alloy.tftpl", {tempo_enabled = true, tempo_sampling_percentage = 10})
//    and then `alloy validate` on the output, before terraform apply.

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}
	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}
	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		target_label  = "app"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki.observability.svc.cluster.local:3100/loki/api/v1/push"
	}
}

otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.exporter.debug.default.input%{ if tempo_enabled }, otelcol.processor.probabilistic_sampler.tempo.input%{ endif }]
	}
}

otelcol.exporter.debug "default" {
	verbosity = "basic"
}
%{ if tempo_enabled ~}

// Hashar på trace-id, så antingen hela eller inga delar av ett trace sparas (ingen halv-trace i Grafana).
otelcol.processor.probabilistic_sampler "tempo" {
	sampling_percentage = ${tempo_sampling_percentage}

	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo.observability.svc.cluster.local:4317"

		tls {
			insecure = true
		}
	}
}
%{ endif ~}
