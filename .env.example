# Copy to .env.local per service as needed. Never commit real secrets.

NODE_ENV=development

# --- Postgres shards ---
DATABASE_URL_SHARD_0=postgresql://postgres:postgres@localhost:5432/tickets
DATABASE_URL_SHARD_1=postgresql://postgres:postgres@localhost:5452/tickets

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PostHog ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Service ports (local dev) ---
BOOKING_API_PORT=3000
REALTIME_GATEWAY_PORT=3001
PAYMENT_MOCK_PORT=3002
