# Copy to .env.local per service as needed. Never commit real secrets.

NODE_ENV=development

# --- Postgres shards ---
DATABASE_URL_SHARD_0=postgresql://postgres:postgres@localhost:5432/tickets
DATABASE_URL_SHARD_1=postgresql://postgres:postgres@localhost:5452/tickets

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Queue token (HMAC, docs/plan.md "Väntrum") ---
QUEUE_TOKEN_SECRET=

# --- Rate limiting (docs/plan.md "Botskydd") ---
RATE_LIMIT_PER_SECOND=50

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Satta under lasttest för att peka om samma klientkod mot payment-mock
# i stället för riktiga Stripe (docs/plan.md "payment-mock för lasttest").
STRIPE_HOST=
STRIPE_PORT=

# --- Betalning (docs/plan.md "Betalning") ---
# HMAC-nyckel för QR-biljetternas qr_token (docs/plan.md "Databas").
QR_TOKEN_SECRET=
PAYMENT_FROZEN_MINUTES=10
CHECKOUT_SUCCESS_URL=https://example.test/checkout/success
CHECKOUT_CANCEL_URL=https://example.test/checkout/cancel

# --- payment-mock (docs/plan.md "payment-mock för lasttest") ---
BOOKING_API_WEBHOOK_URL=http://localhost:3000/webhooks/stripe
PAYMENT_MOCK_CHECKOUT_BASE_URL=http://localhost:3002/mock-checkout
PAYMENT_MOCK_LATENCY_MIN_MS=50
PAYMENT_MOCK_LATENCY_MAX_MS=2000
PAYMENT_MOCK_FAILURE_RATE=0.05
PAYMENT_MOCK_DUPLICATE_WEBHOOK_RATE=0.05
PAYMENT_MOCK_LATE_WEBHOOK_RATE=0.02
PAYMENT_MOCK_LATE_WEBHOOK_DELAY_MS=660000

# --- PostHog ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Service ports (local dev) ---
BOOKING_API_PORT=3000
REALTIME_GATEWAY_PORT=3001
PAYMENT_MOCK_PORT=3002
