# Copy to .env.local per service as needed. Never commit real secrets.

NODE_ENV=development

# --- Postgres shards ---
DATABASE_URL_SHARD_0=postgresql://postgres:postgres@localhost:5432/tickets
DATABASE_URL_SHARD_1=postgresql://postgres:postgres@localhost:5452/tickets

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Queue token (HMAC, docs/plan.md "Väntrum") ---
QUEUE_TOKEN_SECRET=

# --- Rate limiting (docs/plan.md "Botskydd") ---
RATE_LIMIT_PER_SECOND=50

# --- CORS (docs/plan.md "Klienter": appen och API:et är alltid olika
# origin) --- kommaseparerad allowlist, aldrig en wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Satta under lasttest för att peka om samma klientkod mot payment-mock
# i stället för riktiga Stripe (docs/plan.md "payment-mock för lasttest").
STRIPE_HOST=
STRIPE_PORT=

# --- Betalning (docs/plan.md "Betalning") ---
# HMAC-nyckel för QR-biljetternas qr_token (docs/plan.md "Databas").
QR_TOKEN_SECRET=
PAYMENT_FROZEN_MINUTES=10
CHECKOUT_SUCCESS_URL=https://example.test/checkout/success
CHECKOUT_CANCEL_URL=https://example.test/checkout/cancel

# --- payment-mock (docs/plan.md "payment-mock för lasttest") ---
BOOKING_API_WEBHOOK_URL=http://localhost:3000/webhooks/stripe
PAYMENT_MOCK_CHECKOUT_BASE_URL=http://localhost:3002/mock-checkout
PAYMENT_MOCK_LATENCY_MIN_MS=50
PAYMENT_MOCK_LATENCY_MAX_MS=2000
PAYMENT_MOCK_FAILURE_RATE=0.05
PAYMENT_MOCK_DUPLICATE_WEBHOOK_RATE=0.05
PAYMENT_MOCK_LATE_WEBHOOK_RATE=0.02
PAYMENT_MOCK_LATE_WEBHOOK_DELAY_MS=660000

# --- PostHog (docs/plan.md 7.7) ---
# Server (booking-api, scheduler-worker). Tom nyckel eller POSTHOG_ENABLED=false = analytics av.
POSTHOG_KEY=
POSTHOG_ENABLED=true

# --- Botskydd (docs/plan.md 8.5) ---
# Tom TURNSTILE_SECRET_KEY = nivå 2 (Turnstile) av, nivå 1 (proof of work) gäller. Cloudflares testnycklar för
# lokal utveckling: secret 1x0000000000000000000000000000000AA (alltid godkänd), site key 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Undantag åt lasttestet (sätts av scripts/loadtest-mode.sh, aldrig i vanlig drift).
CHALLENGE_BYPASS_TOKEN=
# --- Vite-appar (VITE_*) ---
# Vite läser .env från appens egen katalog: lägg värdena i apps/web/.env.local och
# apps/scanner/.env.local, inte här. Händelserna till PostHog går via /ingest på egen domän.
#   apps/web:     VITE_API_BASE_URL, VITE_WS_BASE_URL, VITE_AUTH0_DOMAIN, VITE_AUTH0_AUDIENCE,
#                 VITE_AUTH0_CLIENT_ID, VITE_POSTHOG_KEY (valfri)
#   apps/scanner: VITE_API_BASE_URL, VITE_AUTH0_DOMAIN, VITE_AUTH0_AUDIENCE,
#                 VITE_AUTH0_CLIENT_ID (SPA-appen "Scanner", inte webbappens) (docs/plan.md 7.8)

# --- Service ports (local dev) ---
BOOKING_API_PORT=3000
REALTIME_GATEWAY_PORT=3001
PAYMENT_MOCK_PORT=3002
